# Opción 2: Atlas. Deja MONGO_URI vacío y completa las variables siguientes.
Mongo_User=
Mongo_Password=
Mongo_Cluster=utvt.qqqotrr.mongodb.net
# También se reconoce Mongo_Closter para compatibilidad con las prácticas previas.

